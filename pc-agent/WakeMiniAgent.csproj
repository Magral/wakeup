<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>wakemini.ico</ApplicationIcon>
    <AssemblyName>WakeMiniAgent</AssemblyName>
    <Version>1.5.1</Version>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="QRCoder" Version="1.6.0" /></ItemGroup>
  <ItemGroup><None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
